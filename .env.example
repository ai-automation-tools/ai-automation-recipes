# Copy to .env (git-ignored). Real environment variables win over this file.

# Where recipe output lands (or pass --output-dir).
RECIPES_OUTPUT_DIR=

# Cover images: set at least one, or run with --image-engine none.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional overrides
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# OPENAI_IMAGE_MODEL=gpt-image-1
# RECIPES_MODEL=sonnet
# CLAUDE_BIN=claude
