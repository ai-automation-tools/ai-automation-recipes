# Copy to .env (git-ignored). Real environment variables win over this file.

# Where recipe output lands. Leave blank for ./output in this clone (git-ignored), which is also
# where build_viewer.py looks. Set it (or pass --output-dir) to keep output somewhere else.
RECIPES_OUTPUT_DIR=

# Cover images: set at least one, or run with --image-engine none.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Audio recipes (songs, podcasts, voiceovers). GEMINI_API_KEY also covers speech.
# Music needs ElevenLabs. Preset voices only — no cloning.
ELEVENLABS_API_KEY=

# Optional: announce every published artifact. Discord and Slack webhook URLs get their own
# message format; any other URL receives the artifact as JSON.
# RECIPES_WEBHOOK_URL=

# Optional: set to off to skip the headless-browser check on game/app recipes.
# RECIPES_BROWSER_CHECK=off

# Optional overrides
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# OPENAI_IMAGE_MODEL=gpt-image-1
# RECIPES_MODEL=sonnet
# RECIPES_SPEECH_ENGINE=auto
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_MUSIC_MODEL=music_v1
# CLAUDE_BIN=claude
