  "cards": [
    {
      "dot": "rose",
      "title": "Fails closed",
      "items": [
        "Any error before the move publishes nothing and deletes staging",
        "A missing image, speech or music key fails before the agent runs",
        "prepare() can raise NothingToDo: RECIPE_SKIPPED, exit 0"
      ]
    },
    {
      "dot": "cyan",
      "title": "Any CLI, one contract",
      "items": [
        "claude, codex, gemini, opencode, kimi, grok: one JSON profile each",
        "The newest profile on main is fetched, cached a day; RECIPES_CLI_REMOTE=0 turns it off",
        "The skills folder is removed after the run, never published"
      ]
    },
    {
      "dot": "violet",
      "title": "Two editions",
      "items": [
        "Clone edition runs run.py from your clone",
        "Cronsole edition downloads the VERSION bundle and checks its pinned sha256",
        "Both print RECIPE_OK, RECIPE_FAILED or RECIPE_SKIPPED"
      ]
    }
  ]
